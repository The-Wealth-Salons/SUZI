# The merged dependency graph contains one peerOptional conflict that npm
# cannot resolve strictly (@hookform/resolvers optionally peers
# ajv-formats@^2 while resource.extract requires ajv-formats@^3 for ajv v8).
# Bun (the website toolchain) does not enforce this optional peer; npm must
# be told the same, or `npm ci` fails with ERESOLVE despite a valid lockfile.
legacy-peer-deps=true
