{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/The-Wealth-Salons/SUZI/contracts/tasks/resource.extract.v1/output.schema.json",
  "title": "resource.extract.v1 model output",
  "description": "What the model may return. The model never supplies verification, publication or provenance fields; SUZI adds spans and the receipt in the result envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "outcome",
    "abstention_reason",
    "claims",
    "unknown_fields",
    "conflicts",
    "review_flags"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "outcome": {
      "enum": [
        "extracted",
        "abstained"
      ]
    },
    "abstention_reason": {
      "enum": [
        null,
        "insufficient_evidence",
        "multiple_resources",
        "target_not_identifiable",
        "unsupported_language",
        "outside_task_scope"
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "unknown_fields": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "$ref": "#/$defs/field"
          },
          "reason": {
            "enum": [
              "not_stated",
              "ambiguous",
              "unreadable",
              "target_unclear"
            ]
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "claim_ids",
          "description"
        ],
        "properties": {
          "field": {
            "$ref": "#/$defs/field"
          },
          "claim_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "review_flags": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "evidence"
        ],
        "properties": {
          "code": {
            "enum": [
              "possible_personal_data",
              "possible_confidential_location",
              "instruction_like_source_text",
              "ambiguous_temporal_context",
              "possible_multiple_resources"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/evidenceReference"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "extracted"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "abstention_reason": {
            "const": null
          },
          "claims": {
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "abstained"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "abstention_reason": {
            "type": "string"
          },
          "claims": {
            "maxItems": 0,
            "type": "array"
          },
          "conflicts": {
            "maxItems": 0,
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "field": {
      "enum": [
        "name",
        "provider_name",
        "description",
        "cost",
        "service_area",
        "eligibility_description",
        "availability",
        "application_deadline",
        "application_url",
        "contact",
        "hours",
        "languages",
        "accessibility",
        "application_requirements"
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "block_id",
        "quote"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "block_id": {
          "$ref": "#/$defs/id"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "field",
        "value",
        "assertion_kind",
        "evidence"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "assertion_kind": {
          "enum": [
            "source_statement",
            "reported_experience"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    }
  }
}
