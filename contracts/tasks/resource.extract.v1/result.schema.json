{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/The-Wealth-Salons/SUZI/contracts/tasks/resource.extract.v1/result.schema.json",
  "title": "resource.extract.v1 result data",
  "description": "Envelope SUZI returns for status 'ok' or 'abstained'. Every evidence reference carries the verbatim quote and its resolved UTF-16 [start, end) span in the model-visible block text. Claims are candidates, not verified facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task",
    "request_id",
    "outcome",
    "abstention_reason",
    "claims",
    "unknown_fields",
    "conflicts",
    "review_flags",
    "receipt"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "task": {
      "const": "resource.extract.v1"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "outcome": {
      "enum": [
        "extracted",
        "abstained"
      ]
    },
    "abstention_reason": {
      "enum": [
        null,
        "insufficient_evidence",
        "multiple_resources",
        "target_not_identifiable",
        "unsupported_language",
        "outside_task_scope"
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "field",
          "value",
          "assertion_kind",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/id"
          },
          "field": {
            "$ref": "#/$defs/field"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "assertion_kind": {
            "enum": [
              "source_statement",
              "reported_experience"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/spannedReference"
            }
          }
        }
      }
    },
    "unknown_fields": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "$ref": "#/$defs/field"
          },
          "reason": {
            "enum": [
              "not_stated",
              "ambiguous",
              "unreadable",
              "target_unclear"
            ]
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "claim_ids",
          "description"
        ],
        "properties": {
          "field": {
            "$ref": "#/$defs/field"
          },
          "claim_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "review_flags": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "evidence"
        ],
        "properties": {
          "code": {
            "enum": [
              "possible_personal_data",
              "possible_confidential_location",
              "instruction_like_source_text",
              "ambiguous_temporal_context",
              "possible_multiple_resources"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/spannedReference"
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_package",
        "prompt_digest",
        "input_schema_digest",
        "output_schema_digest",
        "input_digest",
        "adapter",
        "finish_reason",
        "attempts",
        "usage",
        "validation"
      ],
      "properties": {
        "prompt_package": {
          "type": "string",
          "pattern": "^resource\\.extract\\.v1@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "prompt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "input_schema_digest": {
          "$ref": "#/$defs/sha256"
        },
        "output_schema_digest": {
          "$ref": "#/$defs/sha256"
        },
        "input_digest": {
          "$ref": "#/$defs/sha256"
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter_id",
            "model_ref",
            "mock"
          ],
          "properties": {
            "adapter_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "mock": {
              "type": "boolean"
            }
          }
        },
        "finish_reason": {
          "const": "stop"
        },
        "attempts": {
          "const": 1
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "const": "unknown"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "const": "unknown"
                }
              ]
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_schema",
            "output_schema",
            "evidence_references",
            "evidence_quotes",
            "field_coverage",
            "claim_integrity"
          ],
          "properties": {
            "input_schema": {
              "const": "passed"
            },
            "output_schema": {
              "const": "passed"
            },
            "evidence_references": {
              "const": "passed"
            },
            "evidence_quotes": {
              "const": "passed"
            },
            "field_coverage": {
              "const": "passed"
            },
            "claim_integrity": {
              "const": "passed"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "field": {
      "enum": [
        "name",
        "provider_name",
        "description",
        "cost",
        "service_area",
        "eligibility_description",
        "availability",
        "application_deadline",
        "application_url",
        "contact",
        "hours",
        "languages",
        "accessibility",
        "application_requirements"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spannedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "block_id",
        "quote",
        "span"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "block_id": {
          "$ref": "#/$defs/id"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "unit"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8000
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            },
            "unit": {
              "const": "utf16_code_unit"
            }
          }
        }
      }
    }
  }
}
