{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/The-Wealth-Salons/SUZI/contracts/tasks/resource.extract.v1/input.schema.json",
  "title": "resource.extract.v1 input",
  "description": "Caller-supplied extraction request. Reference fields are syntactic only: SUZI does not resolve them against an external registry in this slice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "target",
    "requested_fields",
    "evidence"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "new_candidate",
            "existing_resource"
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "name_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "existing_resource"
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "resource_id"
        ],
        "properties": {
          "resource_id": {
            "$ref": "#/$defs/id"
          }
        },
        "type": "object"
      },
      "else": {
        "not": {
          "required": [
            "resource_id"
          ],
          "properties": {
            "resource_id": {
              "$ref": "#/$defs/id"
            }
          },
          "type": "object"
        }
      }
    },
    "requested_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/evidenceSource"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+-]{0,255}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "field": {
      "enum": [
        "name",
        "provider_name",
        "description",
        "cost",
        "service_area",
        "eligibility_description",
        "availability",
        "application_deadline",
        "application_url",
        "contact",
        "hours",
        "languages",
        "accessibility",
        "application_requirements"
      ]
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_ref",
        "source_kind",
        "retrieved_at",
        "content_sha256",
        "blocks",
        "provenance"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "source_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_kind": {
          "enum": [
            "provider_material",
            "government_material",
            "community_submission",
            "third_party_material",
            "documented_verification"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "published_at": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        },
        "observed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "retrieved_at": {
          "$ref": "#/$defs/dateTime"
        },
        "language_hint": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8}){0,3}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "block_id",
              "text"
            ],
            "properties": {
              "block_id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "source_kind"
            ],
            "properties": {
              "source_kind": {
                "const": "provider_material"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin_kind": {
                    "const": "provider_publication"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "required": [
              "source_kind"
            ],
            "properties": {
              "source_kind": {
                "const": "government_material"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin_kind": {
                    "const": "government_publication"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "required": [
              "source_kind"
            ],
            "properties": {
              "source_kind": {
                "const": "community_submission"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin_kind": {
                    "const": "community_contribution"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "required": [
              "source_kind"
            ],
            "properties": {
              "source_kind": {
                "const": "third_party_material"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin_kind": {
                    "const": "third_party_publication"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "required": [
              "source_kind"
            ],
            "properties": {
              "source_kind": {
                "const": "documented_verification"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin_kind": {
                    "const": "documented_verification"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "origin_kind",
        "collected_by_ref",
        "collection_method",
        "verification_state",
        "rights_record_ref",
        "handling_policy_ref",
        "preparation"
      ],
      "properties": {
        "record_ref": {
          "$ref": "#/$defs/ref"
        },
        "origin_kind": {
          "enum": [
            "provider_publication",
            "government_publication",
            "community_contribution",
            "third_party_publication",
            "documented_verification"
          ]
        },
        "contribution_ref": {
          "$ref": "#/$defs/ref"
        },
        "collected_by_ref": {
          "$ref": "#/$defs/ref"
        },
        "collection_method": {
          "enum": [
            "http_fetch",
            "api_import",
            "file_upload",
            "community_form",
            "manual_entry",
            "documented_contact"
          ]
        },
        "verification_state": {
          "enum": [
            "unreviewed",
            "partially_verified",
            "verified",
            "disputed",
            "rejected"
          ]
        },
        "verification_event_ref": {
          "$ref": "#/$defs/ref"
        },
        "rights_record_ref": {
          "$ref": "#/$defs/ref"
        },
        "handling_policy_ref": {
          "$ref": "#/$defs/ref"
        },
        "preparation": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/preparationEvent"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "origin_kind"
            ],
            "properties": {
              "origin_kind": {
                "const": "community_contribution"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "contribution_ref"
            ],
            "properties": {
              "contribution_ref": {
                "$ref": "#/$defs/ref"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "required": [
              "verification_state"
            ],
            "properties": {
              "verification_state": {
                "not": {
                  "const": "unreviewed"
                }
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "verification_event_ref"
            ],
            "properties": {
              "verification_event_ref": {
                "$ref": "#/$defs/ref"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "preparationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ref",
        "operation",
        "performed_at",
        "performed_by_ref",
        "implementation_ref",
        "input_artifact_refs",
        "output_artifact_ref"
      ],
      "properties": {
        "event_ref": {
          "$ref": "#/$defs/ref"
        },
        "operation": {
          "enum": [
            "html_to_text",
            "document_text_extraction",
            "ocr",
            "redaction",
            "translation",
            "normalization",
            "segmentation"
          ]
        },
        "performed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "performed_by_ref": {
          "$ref": "#/$defs/ref"
        },
        "implementation_ref": {
          "$ref": "#/$defs/ref"
        },
        "input_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "output_artifact_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    }
  }
}
